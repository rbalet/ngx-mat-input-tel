{
  "name": "ngx-mat-input-tel",
  "version": "22.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build ngx-mat-input-tel --configuration production",
    "test": "ng test ngx-mat-input-tel --watch=false",
    "test:ci": "ng test ngx-mat-input-tel --watch=false --coverage",
    "lint": "ng lint",
    "publish": "ng build ngx-mat-input-tel --configuration production && npm run copy-files && npm publish ./dist/ngx-mat-input-tel",
    "copy-files": "cp README.md dist/ngx-mat-input-tel && cp LICENSE dist/ngx-mat-input-tel",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "@angular/animations": "22.0.0",
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/material": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@angular/router": "22.0.0",
    "libphonenumber-js": "1.13.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.0.0",
    "@angular-devkit/schematics": "22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@angular/language-service": "22.0.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/jasmine": "5.1.15",
    "@types/jasminewd2": "2.0.13",
    "@types/node": "24.13.1",
    "@vitest/coverage-v8": "4.1.8",
    "angular-eslint": "22.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.13.0",
    "jasmine-spec-reporter": "7.0.0",
    "jsdom": "29.1.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "lint-staged": "17.0.7",
    "ng-packagr": "22.0.0",
    "prettier": "3.8.4",
    "semantic-release": "25.0.5",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "dist/ngx-mat-input-tel",
          "access": "public"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
